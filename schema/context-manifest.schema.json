{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/allyburns/context-manifest/main/schema/context-manifest.schema.json",
  "title": "Context Manifest 0.1",
  "type": "object",
  "required": ["spec", "app", "purpose", "requests"],
  "additionalProperties": false,
  "properties": {
    "spec": { "type": "string", "pattern": "^context-manifest/0\\.1$" },
    "app": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "url": { "type": "string", "format": "uri" },
        "operator": { "type": "string", "maxLength": 120 },
        "privacy_policy": { "type": "string", "format": "uri" }
      }
    },
    "purpose": { "type": "string", "minLength": 10, "maxLength": 200 },
    "requests": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/request" } },
    "offers": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/offer" } },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": { "type": "string", "format": "uri" },
        "share": { "type": "string", "format": "uri" },
        "paste": { "type": "string", "format": "uri" },
        "manage": { "type": "string", "format": "uri" },
        "revoke": { "type": "string", "format": "uri" }
      }
    },
    "i18n": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
      "additionalProperties": { "$ref": "#/$defs/translation" }
    },
    "ext": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "requests": { "minItems": 1 } } },
      "then": {
        "required": ["endpoints"],
        "properties": {
          "endpoints": {
            "required": ["manage"],
            "anyOf": [{ "required": ["mcp"] }, { "required": ["share"] }, { "required": ["paste"] }]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "requests": { "contains": { "properties": { "retention": { "const": "saved" } }, "required": ["retention"] } } }
      },
      "then": { "properties": { "endpoints": { "required": ["manage", "revoke"] } }, "required": ["endpoints"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^(x-)?[a-z][a-z0-9_]{1,63}$" },
    "class": { "type": "string", "enum": ["preference", "plan", "people", "protected"] },
    "request": {
      "type": "object",
      "required": ["id", "scope", "ask", "why", "schema", "class", "retention", "derive"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": { "type": "string", "pattern": "^context:(x-)?[a-z][a-z0-9_]{1,63}\\.read$" },
        "ask": { "type": "string", "minLength": 5, "maxLength": 140 },
        "why": { "type": "string", "minLength": 5, "maxLength": 200 },
        "feature": { "type": "string", "maxLength": 64 },
        "schema": { "type": "object" },
        "class": { "$ref": "#/$defs/class" },
        "retention": { "type": "string", "enum": ["session", "saved"] },
        "ttl": { "type": "string", "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" },
        "derive": { "type": "boolean" },
        "required": { "type": "boolean", "default": false },
        "about": { "type": "string", "enum": ["self", "other", "either"], "default": "self" },
        "examples": { "type": "array", "maxItems": 5 },
        "ext": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "retention": { "const": "saved" } } }, "then": { "required": ["ttl"] } },
        {
          "if": { "properties": { "class": { "not": { "const": "preference" } } } },
          "then": { "properties": { "derive": { "const": false } } }
        },
        {
          "if": { "properties": { "about": { "enum": ["other", "either"] } }, "required": ["about"] },
          "then": { "properties": { "class": { "enum": ["people", "protected"] } } }
        }
      ]
    },
    "offer": {
      "type": "object",
      "required": ["id", "scope", "what", "why", "schema", "class", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": { "type": "string", "pattern": "^context:(x-)?[a-z][a-z0-9_]{1,63}\\.offer$" },
        "what": { "type": "string", "minLength": 5, "maxLength": 200 },
        "why": { "type": "string", "minLength": 5, "maxLength": 200 },
        "schema": { "type": "object" },
        "class": { "$ref": "#/$defs/class" },
        "provenance": { "type": "string", "enum": ["observed", "stated", "derived"] },
        "cadence": { "type": "string", "enum": ["on_request"], "default": "on_request" },
        "ext": { "type": "object" }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": "string", "minLength": 10, "maxLength": 200 },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ask": { "type": "string", "minLength": 5, "maxLength": 140 },
              "why": { "type": "string", "minLength": 5, "maxLength": 200 }
            }
          }
        },
        "offers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "what": { "type": "string", "minLength": 5, "maxLength": 200 },
              "why": { "type": "string", "minLength": 5, "maxLength": 200 }
            }
          }
        }
      }
    }
  }
}
