{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/allyburns/context-manifest/main/schema/error.schema.json",
  "title": "Context Manifest Error 0.1",
  "type": "object",
  "required": ["spec", "error"],
  "additionalProperties": false,
  "properties": {
    "spec": { "type": "string", "pattern": "^context-manifest/0\\.1$" },
    "error": {
      "type": "string",
      "enum": ["unknown_manifest_hash", "invalid_envelope", "too_large", "unauthenticated", "forbidden", "not_found", "rate_limited", "server_error"]
    },
    "message": { "type": "string", "maxLength": 200 },
    "ids": { "type": "array", "items": { "type": "string" } }
  }
}
